DOMAIN=quota.example.com
APP_SECRET=change-this-to-a-long-random-secret
ALLOW_REGISTRATION=1
# 后台每分钟（整点）自动刷新所有账号并保存最新用量（同时驱动 Bark 推送），设为 0 关闭
BACKGROUND_REFRESH=1
# 只读 API token：无头客户端（如 tmux 状态栏）用它拉取额度，免登录免 cookie。
# 仅对 GET 生效（不能改数据），映射到 READ_API_USERNAME 指定的用户。
# 通过 Authorization: Bearer <token> 或 X-API-Key: <token> 传递。留空则关闭。
READ_API_TOKEN=
READ_API_USERNAME=
